  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@vue/eslint-config-typescript": "^14.1.4",
    "eslint": "^9",
    "prisma": "^5.22.0",
